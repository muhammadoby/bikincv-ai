<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Pembayaran Berhasil - AI Analyzer</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f1f1f1;
        }

        table {
            border-collapse: collapse;
        }

        img {
            display: block;
            border: 0;
        }

        a {
            color: #2563eb;
            text-decoration: none;
        }

        .btn {
            display: inline-block;
            padding: 12px 20px;
            background-color: #2563eb;
            color: #ffffff;
            border-radius: 4px;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <center style="width:100%; background:#f1f1f1;">
        <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
                <td align="center">
                    <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;">

                        <tr>
                            <td align="center" style="padding:20px;">
                                <img src="https://www.bikincv.com/images/brand-logo.png" width="200" alt="bikincv.com">
                            </td>
                        </tr>

                        <tr>
                            <td
                                style="padding:40px; font-family:Arial, sans-serif; font-size:14px; line-height:20px; color:#444;">
                                Halo <strong>{{ user.name }}</strong><br><br>

                                Pembayaran kamu berhasil.<br>
                                Order <strong>#{{ orderNumber }}</strong> untuk
                                <strong>AI Analyzer</strong> sudah aktif.<br><br>

                                Kamu sekarang bisa.<br>
                                • Melihat skor CV kamu<br>
                                • Mendapatkan insight dan rekomendasi perbaikan<br>
                                • Mengakses seluruh fitur AI Analyzer<br><br>


                                Terima kasih sudah menggunakan BikinCV.
                            </td>
                        </tr>

                        <tr>
                            <td align="center" style="padding:30px; font-size:12px; color:#888; font-family:Arial;">
                                © {{ new Date().getFullYear() }} PT BIKIN INOVASI TEKNOLOGI<br>
                                Jalan Sulatri 168x, Denpasar, Bali 80237<br>
                                <a href="https://www.bikincv.com">www.bikincv.com</a>
                            </td>
                        </tr>

                    </table>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>